NODE_ENV=development
PORT=5000
MONGODB_URL=mongodb://127.0.0.1:27017/ventro

# Use two different random values of at least 32 characters in production.
JWT_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional: Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Optional: paid bookings
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: SMTP (preferred in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ventro Events <events@example.com>"

# Gmail fallback for local development
EMAIL_USER=
EMAIL_PASS=

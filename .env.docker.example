# Address users enter in their browser. Include the externally published port.
# For a remote HTTP server, for example: http://192.0.2.10:3000
# For a domain behind an HTTPS reverse proxy, for example: https://events.example.com
PUBLIC_URL=http://localhost:3000
PUBLIC_PORT=3000

# This exact URI must also be added to Google Cloud Console under
# APIs & Services > Credentials > Authorized redirect URIs.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
